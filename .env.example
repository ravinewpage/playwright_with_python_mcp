# Copy this file to .env and fill in real values. .env is gitignored.

# GitHub PAT for ravinewpage (repo scope), used only by the GitHub MCP server.
GITHUB_TOKEN=

# Local Postgres connection used by the SQL MCP server.
DATABASE_URL=postgresql://localhost/playwright_mcp

